; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Neon Haven"
config/description="霓湾 — 可自由观察与摄影的 3D 城市场景展示程序"
run/main_scene="res://scenes/app/main.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[editor_plugins]

enabled=PackedStringArray("res://addons/neon_bake/plugin.cfg")

[rendering]

renderer/rendering_method="mobile"
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.13, 0.17, 0.24, 1)
occlusion_culling/use_occlusion_culling=true
